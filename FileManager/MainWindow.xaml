<Window x:Class="FileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FileManager" Height="450" Width="800" MaxWidth="800" MaxHeight="450" MinHeight="450" WindowStartupLocation="CenterScreen">
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="390"/>
        </Grid.RowDefinitions>
        <Grid Grid.ColumnSpan="2">
            <Border BorderBrush="LightGray" BorderThickness="1"/>
            <Button x:Name="butBack" IsEnabled="False" Width="32" Content="назад" FontSize="10" HorizontalAlignment="Left" Click="GetParentDirectories"/>
            <Button x:Name="butForward" Width="32" IsEnabled="False" Content="вперёд" HorizontalAlignment="Left" Margin="32,0,0,0" FontSize="10"/>
            <TextBox x:Name="tbPath" FontSize="10" Width="720" HorizontalAlignment="Right"/>
        </Grid>
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Grid.Row="2" Grid.Column="2">
            <Grid x:Name="ContentGrid" MaxWidth="648">
                <Grid Height="25" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Opacity="0.5" Grid.Column="1" Text="Имя"/>
                    <TextBlock Opacity="0.5" Grid.Column="2" Text="Размер" TextAlignment="Right"/>
                </Grid>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Border BorderBrush="LightGray" BorderThickness="1" />
        </Grid>
    </Grid>
</Window>
